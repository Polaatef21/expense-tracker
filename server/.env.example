# Copy this file to `.env` and fill in the blank values.
# NEVER commit the real `.env` file.

# --- App ---
NODE_ENV=development
PORT=5000
# The front-end origin allowed by CORS (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=expense_app
DB_PASSWORD=
DB_NAME=expense_tracker
# Separate database used only by automated tests (gets wiped between runs)
DB_NAME_TEST=expense_tracker_test

# --- Authentication ---
# Use a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12
