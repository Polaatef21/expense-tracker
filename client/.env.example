# Copy this file to `.env` if you need to change these settings.
# Only variables prefixed with VITE_ are exposed to the browser —
# so NEVER put secrets in this file.

# Where the API lives
VITE_API_URL=http://localhost:5000/api

# ISO 4217 currency code used for displaying amounts (e.g. USD, EUR, EGP)
VITE_CURRENCY=USD
